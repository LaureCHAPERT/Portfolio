<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Laure Chapert{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#561C24">
        <meta name="author" content="Laure Chapert" />
        <meta name="copyright" content="Laure Chapert" />
        <meta property="og:locale" content="{{ app.request.locale == 'en' ? 'en_GB' : 'fr_FR' }}" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="Laure Chapert – {{ 'homepage_title'|trans }}" />
        <meta name="description" content="{{ 'meta_description'|trans }}" />
        <meta property="og:description" content="{{ 'meta_description'|trans }}" />
        <meta name="keywords" content="PHP, Symfony, React, TypeScript, Python, IA, LLM, MCP, web, Javascript, developer, fullstack, back-end, front-end, design system, Zei, ESG, Qrew, GitHub" />
        <meta name="robots" content="index,follow">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
        <link rel="icon" type="image/svg+xml" href="{{ asset('icons/favicon.svg')}}">
        <!-- Google tag (gtag.js) -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-1JSY77B3DK"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-1JSY77B3DK');
        </script>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
