{% block body %}
    <div class="contact">
        <div class="contact-form">
            <h3>{{ 'contact_page.send_me'|trans }}</h3>
            <div id="flashbag-container" class="hidden"></div>
            {{ form_start(form, {'action': path('sendEmail'), 'attr': {'id': 'contact-form', 'data-success-message': 'contact_page.success'|trans, 'data-error-message': 'contact_page.error'|trans}}) }}
                <div class="form-group">
                    {{ form_label(form.fullName, 'contact_page.name'|trans) }}
                    {{ form_widget(form.fullName, {'attr': {'autocomplete': 'name'}, 'required': true}) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.email, 'contact_page.email'|trans) }}
                    {{ form_widget(form.email, {'attr': {'autocomplete': 'email'}, 'required': true}) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.message, 'contact_page.message'|trans) }}
                    {{ form_widget(form.message, {'attr': {'rows': 5}, 'required': true}) }}
                </div>
                <button type="submit" class="btn btn-light">{{ 'contact_page.send'|trans }}</button>
            {{ form_end(form) }}
        </div>
        <div class="contact-links">
            <h3>{{ 'contact_page.or_contact_me'|trans }}</h3>
            <ul>
