{% extends 'base.html.twig' %}

{% block title %}Laure Chapert {% endblock %}

{% block body %}
    <ul id="languages">
        <li>
            <a href="{{ path(app.request.attributes.get('_route'), {_locale: 'fr'}) }}" hreflang="fr" lang="fr" aria-label="Version française">
                <img class="flag" src="{{ asset('icons/fr-flag.svg') }}" alt="">
            </a>
        </li>
        <li>
            <a href="{{ path(app.request.attributes.get('_route'), {_locale: 'en'}) }}" hreflang="en" lang="en" aria-label="English version">
                <img class="flag" src="{{ asset('icons/uk-flag.svg') }}" alt="">
            </a>
        </li>
    </ul>

    <main id="main-content">
        <div class="homepage-title">
            <h1>Laure CHAPERT</h1>
            <p>{{ 'homepage_title'|trans }}</p>
        </div>
        <div class="arrowToDownDiv" role="button" tabindex="0" aria-label="{{ 'a11y.scroll_down'|trans }}">
            <img class="arrowToDown" src="{{ asset('icons/Arrow.svg') }}" alt="">
            <img class="arrowLine" src="{{ asset('icons/ArrowLine.svg') }}" alt="">
        </div>
    </main>

    <aside class="pages">
        <nav class="nav-tabs" aria-label="{{ 'a11y.main_navigation'|trans }}">
            <div class="nav-tab about-tab active" role="button" tabindex="0">
                <span class="text"> {{ 'navigation.about'|trans }} </span>
                <img class="arrow" src="{{ asset('icons/About.svg') }}" alt="">
            </div>
            <div class="nav-tab achievements-tab" role="button" tabindex="0">
                <span class="text"> {{ 'navigation.achievements'|trans }} </span>
                <img class="arrow" src="{{ asset('icons/Achievements.svg') }}" alt="">
            </div>
            <div class="nav-tab contact-tab" role="button" tabindex="0">
                <span class="text"> {{ 'navigation.contact'|trans }} </span>
                <img class="arrow" src="{{ asset('icons/Contact.svg') }}" alt="">
            </div>
        </nav>
        <div class="page" id="aboutPage">
            <article id="about">
                <h1>{{ 'about_page.title'|trans }}</h1>
                <div class="aiPortrait">
                    <img class="desktop" src="{{ asset('images/AIPortraitSketch.jpg') }}" alt="{{ 'a11y.ai_portrait'|trans }}">
                </div>
                <div class="presentationText">
                    <p>{{ 'about_page.first_paragraph'|trans }}</p> <br>
                    <p>{{ 'about_page.second_paragraph'|trans }}</p> <br>
                    <p>{{ 'about_page.third_paragraph'|trans }}</p> <br>
                    <p class="imageCaption">{{ 'about_page.fourth_paragraph'|trans }}</p>
                </div>
            </article>
        </div>
        <div class="page" id="achievementsPage">
            <article id="achievements">
                <div class="splide" aria-labelledby="QuickMS">
                    <div class="splide__track">
                        <ul class="splide__list">
                            {% set notion_site = 'https://evanescent-find-18f.notion.site/' %}
                            <li class="splide__slide">
                                <h1 class="projectTitle">Zei <span>{{ 'achievements_page.professional_project'|trans }}</span></h1>
                                <p class="projectPeriod">{{ 'achievements_page.zei_period'|trans }}</p>
                                <div class="badges">
                                    <div class="badge backBadge">Symfony 7</div>
                                    <div class="badge backBadge">API Platform</div>
                                    <div class="badge frontBadge">React</div>
                                    <div class="badge frontBadge">TypeScript</div>
                                    <div class="badge frontBadge">Tailwind CSS</div>
                                    <div class="badge environmentBadge">Storybook</div>
                                    <div class="badge environmentBadge">Docker</div>
                                </div>
                                <p class="achievementsText">{{ 'achievements_page.zei_description'|trans }}</p>
                                <figure class="zeiImage">
                                    <img class="desktop" loading="lazy" src="{{ asset('images/ZeiReportEditorDesktop.webp') }}" alt="{{ 'achievements_page.zei_image_alt'|trans }}">
                                    <img class="mobile" loading="lazy" src="{{ asset('images/ZeiReportEditorMobile.webp') }}" alt="{{ 'achievements_page.zei_image_alt'|trans }}">
                                    <figcaption>{{ 'achievements_page.zei_image_caption'|trans }}</figcaption>
                                </figure>
                                <div class="caseStudies">
                                    <h2>{{ 'achievements_page.case_studies'|trans }}</h2>
                                    <ul>
                                        {% for key, notion_id in {
                                            report_editor: '41e3fa0c953a8191ba2cc7aaf2054ba1',
                                            design_system: '41e3fa0c953a813ab821c50ae4ea27ff',
                                            permissions: '41e3fa0c953a81188309d67dd12f0bc3',
                                        } %}
                                            <li><a href="{{ notion_site ~ notion_id }}" target="_blank" rel="noopener">{{ ('achievements_page.zei_case_studies.' ~ key)|trans }}</a></li>
                                        {% endfor %}
                                    </ul>
                                </div>
                                <div class="badges">
                                    <a href="{{ notion_site }}ZEI-41e3fa0c953a81879ca9ed319bec897e" target="_blank" rel="noopener">
                                        <div class="badge showMore">{{ 'achievements_page.find_out_more'|trans }}</div>
                                    </a>
                                </div>
                            </li>
                            <li class="splide__slide">
                                <h1 class="projectTitle">Qrew <span>{{ 'achievements_page.professional_project'|trans }}</span> </h1>
                                <div class="badges">
                                    <div class="badge backBadge">Symfony</div>
                                    <div class="badge frontBadge">Vue JS</div>
                                    <div class="badge frontBadge">Javascript Vanilla</div>
                                    <div class="badge frontBadge">Sass / Bootstrap</div>
                                    <div class="badge environmentBadge">Docker</div>
                                    <div class="badge environmentBadge">Linux</div>
                                </div>
                                <p class="achievementsText">{{ 'achievements_page.qrew_description'|trans }}</p>
                                <div class="projectImage">
                                    <img class="desktop" src="{{ asset('images/QrewDesktop.png') }}">
                                    <img class="mobile" src="{{ asset('images/QrewMobile.PNG') }}">
                                </div>
                                <div class="badges">
                                    <a href="https://evanescent-find-18f.notion.site/QREW-c07579b7afb74416983a5f92b5ab93ed?pvs=74">
                                        <div class="badge showMore">{{ 'achievements_page.find_out_more'|trans }}</div>
                                    </a>
                                </div>
                            </li>
                            <li class="splide__slide">
                                <h1 class="projectTitle">Concert'O <span>{{ 'achievements_page.personal_project'|trans }}</span></h1>
                                <div class="badges">
                                    <div class="badge backBadge">Symfony</div>
                                    <div class="badge frontBadge">React / React Router</div>
                                    <div class="badge frontBadge">Javascript Vanilla</div>
                                    <div class="badge frontBadge">Sass</div>
                                    <div class="badge frontBadge">Bootstrap / ReactBootstrap</div>
                                </div>
                                <p class="achievementsText">{{ 'achievements_page.concerto_description'|trans }}</p>
                                <div class="projectImage">
                                    <img class="desktop" src="{{ asset('images/ConcertoDesktop.PNG') }}">
                                    <img class="mobile" src="{{ asset('images/ConcertoMobile.PNG') }}">
                                </div>
                                <div class="badges">
                                    <a href="https://evanescent-find-18f.notion.site/Concert-o-9e33e38887874db49650591d09c2010c?pvs=25">
                                        <div class="badge showMore">{{ 'achievements_page.find_out_more'|trans }}</div>
                                    </a>
                                </div>
                            </li>
                            <li class="splide__slide">
                                <h1 class="projectTitle">{{ 'achievements_page.first_portfolio'|trans}} <span>{{ 'achievements_page.personal_project'|trans }}</span></h1>
                                <div class="badges">
                                    <div class="badge backBadge">Laravel</div>
                                    <div class="badge frontBadge">Javascript Vanilla</div>
                                    <div class="badge frontBadge">CSS/Bootstrap</div>
                                </div>
                                <p class="achievementsText">{{ 'achievements_page.first_portfolio_description'|trans }}</p>
                                <div class="projectImage">
                                    <img class="desktop" src="{{ asset('images/PortfolioDesktop.PNG') }}">
                                    <img class="mobile" src="{{ asset('images/PortfolioMobile.PNG') }}">
                                </div>
                                <div class="badges">
                                    <a href="https://evanescent-find-18f.notion.site/Premier-Portfolio-51db66b3381f4a8f86781f6b97416088?pvs=4">
                                        <div class="badge showMore">{{ 'achievements_page.find_out_more'|trans }}</div>
                                    </a>
                                </div>
                            </li>
                            <li class="splide__slide">
                                <h1 class="projectTitle">{{ 'achievements_page.second_portfolio'|trans}} <span>{{ 'achievements_page.personal_project'|trans }}</span></h1>
                                <div class="badges">
                                    <div class="badge backBadge">Symfony</div>
                                    <div class="badge frontBadge">Javascript Vanilla</div>
                                    <div class="badge frontBadge">CSS</div>
                                </div>
                                <p class="achievementsText">{{ 'achievements_page.second_portfolio_description'|trans }}</p>
                                <div class="projectImage">
                                    <img class="desktop" src="{{ asset('images/PalettesDesktop.png') }}">
                                    <img class="mobile" src="{{ asset('images/PalettesMobile.PNG') }}">
                                </div>
                                <div class="badges">
                                    <a href="https://evanescent-find-18f.notion.site/Portfolio-Actuel-d8d871a5ca87461c9f4166354aa9b0ed?pvs=4">
                                        <div class="badge showMore">{{ 'achievements_page.find_out_more'|trans }}</div>
                                    </a>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </article>
        </div>
        <div class="page" id="contactPage">
            <div class="overlay"></div>
            <article>
                {{ render_esi(url('contact')) }}
            </article>
        </div>
        <div class="arrowToUpDiv" role="button" tabindex="0" aria-label="{{ 'a11y.back_to_top'|trans }}">
            <img class="arrowToUp" src="{{ asset('icons/ArrowToUp.svg') }}" alt="">
        </div>
    </aside>

{% endblock %}

