{% extends 'base.html.twig' %}

{% block title %}Laure Chapert – {{ 'homepage_title'|trans }}{% endblock %}

{% macro icon(name) %}
    {%- if name == 'github' -%}
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.330-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.280-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
    {%- elseif name == 'linkedin' -%}
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.140 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
    {%- elseif name == 'mail' -%}
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm-1 1 9 7 9-7"/></svg>
    {%- elseif name == 'arrow' -%}
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9"/></svg>
    {%- elseif name == 'up' -%}
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="m6 15 6-6 6 6"/></svg>
    {%- endif -%}
{% endmacro %}

{% block body %}
    {% import _self as ui %}
    {% set route = app.request.attributes.get('_route') %}
    {% set notion_site = 'https://evanescent-find-18f.notion.site/' %}
    <a class="skip-link" href="#content">{{ 'a11y.skip_to_content'|trans }}</a>

    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="#top">Laure Chapert</a>
            <nav class="main-nav" aria-label="{{ 'a11y.main_navigation'|trans }}">
                <ul>
                    <li><a href="#about">{{ 'navigation.about'|trans }}</a></li>
                    <li><a href="#experience">{{ 'navigation.experience'|trans }}</a></li>
                    <li><a href="#projects">{{ 'navigation.projects'|trans }}</a></li>
                    <li><a href="#contact">{{ 'navigation.contact'|trans }}</a></li>
                </ul>
            </nav>
            <ul class="lang-switch" aria-label="{{ 'a11y.language'|trans }}">
                <li><a href="{{ path(route, {_locale: 'fr'}) }}" hreflang="fr" lang="fr" {% if app.request.locale == 'fr' %}aria-current="true"{% endif %} aria-label="Français">FR</a></li>
                <li><a href="{{ path(route, {_locale: 'en'}) }}" hreflang="en" lang="en" {% if app.request.locale == 'en' %}aria-current="true"{% endif %} aria-label="English">EN</a></li>
            </ul>
        </div>
    </header>

    <main id="content">
        {# ---------- Accueil ---------- #}
        <section class="hero" id="top">
            <div class="container hero-inner">
                <a class="availability" href="#remote-title"><span class="availability-dot" aria-hidden="true"></span>{{ 'hero.availability'|trans }}</a>
                <p class="eyebrow">{{ 'hero.stack'|trans }}</p>
                <h1>Laure Chapert</h1>
                <p class="hero-title">{{ 'homepage_title'|trans }}</p>
                <p class="hero-pitch">{{ 'hero.pitch'|trans }}</p>
                <div class="hero-actions">
                    <a class="btn btn-primary" href="#experience">{{ 'hero.cta_experience'|trans }}</a>
                    <a class="btn btn-secondary" href="#contact">{{ 'hero.cta_contact'|trans }}</a>
                    <a class="icon-link" href="https://github.com/LaureCHAPERT" target="_blank" rel="noopener" aria-label="GitHub {{ 'a11y.new_tab'|trans }}">{{ ui.icon('github') }}</a>
                    <a class="icon-link" href="https://www.linkedin.com/in/laurechapert/" target="_blank" rel="noopener" aria-label="LinkedIn {{ 'a11y.new_tab'|trans }}">{{ ui.icon('linkedin') }}</a>
                </div>
            </div>
        </section>

        {# ---------- À propos ---------- #}
        <section class="section section-alt" id="about" aria-labelledby="about-title">
            <div class="container about">
                <div class="about-intro">
                    <img class="portrait" src="{{ asset('images/LaureChapert.webp') }}" alt="{{ 'a11y.portrait'|trans }}" width="180" height="180" loading="lazy">
                    <div>
                        <h2 class="section-title" id="about-title">{{ 'about_page.title'|trans }}</h2>
                        <p class="about-lead">{{ 'about_page.first_paragraph'|trans }}</p>
                    </div>
                </div>
                <div class="about-body">
                    <p>{{ 'about_page.second_paragraph'|trans }}</p>
                    <p>{{ 'about_page.third_paragraph'|trans }}</p>
                    <p>{{ 'about_page.fourth_paragraph'|trans }}</p>
                    <p>{{ 'about_page.fifth_paragraph'|trans }}</p>
                </div>
                <aside class="remote-callout" aria-labelledby="remote-title">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
                    <div>
                        <h3 id="remote-title">{{ 'about_page.remote_title'|trans }}</h3>
                        <p>{{ 'about_page.remote_text'|trans }}</p>
                    </div>
                </aside>
            </div>
        </section>

        {# ---------- Expérience ---------- #}
        <section class="section" id="experience" aria-labelledby="experience-title">
            <div class="container">
                <h2 class="section-title" id="experience-title">{{ 'experience_page.title'|trans }}</h2>

                <ol class="timeline">
                    <li class="timeline-item">
                        <article class="card job">
                            <header class="job-header">
                                <div>
                                    <h3>Zei</h3>
                                    <p class="job-role">{{ 'achievements_page.zei_role'|trans }}</p>
                                </div>
                                <p class="job-period">{{ 'achievements_page.zei_period'|trans }}</p>
                            </header>
                            <p>{{ 'achievements_page.zei_description'|trans }}</p>
                            <ul class="tags">
                                {% for tag in ['Symfony 7', 'API Platform', 'React', 'TypeScript', 'Tailwind CSS', 'Storybook', 'Docker'] %}
                                    <li>{{ tag }}</li>
                                {% endfor %}
                            </ul>
                            <figure class="job-figure">
                                <picture>
                                    <source media="(max-width: 640px)" srcset="{{ asset('images/ZeiReportEditorMobile.webp') }}">
                                    <img src="{{ asset('images/ZeiReportEditorDesktop.webp') }}" alt="{{ 'achievements_page.zei_image_alt'|trans }}" loading="lazy" width="1400" height="715">
                                </picture>
                                <figcaption>{{ 'achievements_page.zei_image_caption'|trans }}</figcaption>
                            </figure>
                            <h4>{{ 'achievements_page.case_studies'|trans }}</h4>
                            <ul class="case-studies">
                                {% for key, notion_id in {
                                    report_editor: '41e3fa0c953a8191ba2cc7aaf2054ba1',
                                    design_system: '41e3fa0c953a813ab821c50ae4ea27ff',
                                    permissions: '41e3fa0c953a81188309d67dd12f0bc3',
                                } %}
                                    <li>
                                        <a href="{{ notion_site ~ notion_id }}" target="_blank" rel="noopener">
                                            {{ ('achievements_page.zei_case_studies.' ~ key)|trans }}{{ ui.icon('arrow') }}<span class="visually-hidden"> {{ 'a11y.new_tab'|trans }}</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                            <a class="btn btn-secondary btn-small" href="{{ notion_site }}ZEI-41e3fa0c953a81879ca9ed319bec897e" target="_blank" rel="noopener">
                                {{ 'achievements_page.find_out_more'|trans }}<span class="visually-hidden"> – Zei {{ 'a11y.new_tab'|trans }}</span>
                            </a>
                        </article>
                    </li>
                    <li class="timeline-item">
                        <article class="card job">
                            <header class="job-header">
                                <div>
                                    <h3>Qrew <span class="job-company">· {{ 'achievements_page.qrew_company'|trans }}</span></h3>
                                    <p class="job-role">{{ 'achievements_page.qrew_role'|trans }}</p>
                                </div>
                                <p class="job-period">{{ 'achievements_page.qrew_period'|trans }}</p>
                            </header>
                            <p>{{ 'achievements_page.qrew_description'|trans }}</p>
                            <ul class="tags">
                                {% for tag in ['Symfony', 'Vue.js', 'JavaScript', 'Sass / Bootstrap', 'Docker', 'Jira'] %}
                                    <li>{{ tag }}</li>
                                {% endfor %}
                            </ul>
                            <figure class="job-figure">
                                <picture>
                                    <source media="(max-width: 640px)" srcset="{{ asset('images/QrewMobile.PNG') }}">
                                    <img src="{{ asset('images/QrewDesktop.png') }}" alt="{{ 'achievements_page.qrew_image_alt'|trans }}" loading="lazy" width="1803" height="940">
                                </picture>
                            </figure>
                            <h4>{{ 'achievements_page.case_studies'|trans }}</h4>
                            <ul class="case-studies">
                                {% for key, notion_id in {
                                    dashboards: '0df5903e23e64c5db918cdbc9b2fcbba',
                                    datatables: '9e8d625a5c454b90ac49c68cf4f9a984',
                                    upgrade: 'facd0f062a4942c49f4c5d9bc56ceadf',
                                } %}
                                    <li>
                                        <a href="{{ notion_site ~ notion_id }}" target="_blank" rel="noopener">
                                            {{ ('achievements_page.qrew_case_studies.' ~ key)|trans }}{{ ui.icon('arrow') }}<span class="visually-hidden"> {{ 'a11y.new_tab'|trans }}</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                            <a class="btn btn-secondary btn-small" href="{{ notion_site }}QREW-c07579b7afb74416983a5f92b5ab93ed" target="_blank" rel="noopener">
                                {{ 'achievements_page.find_out_more'|trans }}<span class="visually-hidden"> – Qrew {{ 'a11y.new_tab'|trans }}</span>
                            </a>
                        </article>
                    </li>
                </ol>
            </div>
        </section>

        {# ---------- Projets ---------- #}
        <section class="section section-alt" id="projects" aria-labelledby="projects-title">
            <div class="container">
                <h2 class="section-title" id="projects-title">{{ 'projects_page.title'|trans }}</h2>
                <div class="project-grid">
                    <article class="card project project-featured">
                        <picture>
                            <source media="(max-width: 640px)" srcset="{{ asset('images/LesPtitsLoupsMobile.webp') }}">
                            <img src="{{ asset('images/LesPtitsLoupsDesktop.webp') }}" alt="{{ 'achievements_page.loups_image_alt'|trans }}" loading="lazy" width="1400" height="1103">
                        </picture>
                        <div class="project-body">
                            <p class="project-status">{{ 'achievements_page.in_progress'|trans }}</p>
                            <h3>Les P'tits Loups</h3>
                            <p>{{ 'achievements_page.loups_description'|trans }}</p>
                            <p>{{ 'achievements_page.loups_method'|trans }}</p>
                            <ul class="tags">
                                {% for tag in ['SvelteKit', 'TypeScript', 'Tailwind CSS', 'Prisma', 'PostgreSQL', 'Storybook', 'Playwright', 'Docker'] %}
                                    <li>{{ tag }}</li>
                                {% endfor %}
                            </ul>
                            <a class="text-link" href="https://github.com/LaureCHAPERT/Les-Ptits-Loups" target="_blank" rel="noopener">
                                {{ 'achievements_page.see_code'|trans }}{{ ui.icon('arrow') }}<span class="visually-hidden"> – Les P'tits Loups {{ 'a11y.new_tab'|trans }}</span>
                            </a>
                        </div>
                    </article>
                    <article class="card project">
                        <img src="{{ asset('images/ConcertoDesktop.webp') }}" alt="{{ 'achievements_page.concerto_image_alt'|trans }}" loading="lazy" width="1899" height="888">
                        <div class="project-body">
                            <h3>Concert'O</h3>
                            <p>{{ 'achievements_page.concerto_description'|trans }}</p>
                            <ul class="tags">
                                {% for tag in ['Symfony', 'React', 'React Router', 'Sass', 'Bootstrap'] %}
                                    <li>{{ tag }}</li>
                                {% endfor %}
                            </ul>
                            <a class="text-link" href="{{ notion_site }}Concert-o-9e33e38887874db49650591d09c2010c" target="_blank" rel="noopener">
                                {{ 'achievements_page.find_out_more'|trans }}{{ ui.icon('arrow') }}<span class="visually-hidden"> – Concert'O {{ 'a11y.new_tab'|trans }}</span>
                            </a>
                        </div>
                    </article>
                    <article class="card project">
                        <img src="{{ asset('images/PalettesDesktop.png') }}" alt="{{ 'achievements_page.portfolios_image_alt'|trans }}" loading="lazy" width="759" height="810">
                        <div class="project-body">
                            <h3>{{ 'achievements_page.portfolios_title'|trans }}</h3>
                            <p>{{ 'achievements_page.portfolios_description'|trans }}</p>
                            <ul class="tags">
                                {% for tag in ['Symfony 7', 'Laravel', 'CSS', 'JavaScript', 'Figma'] %}
                                    <li>{{ tag }}</li>
                                {% endfor %}
                            </ul>
                            <div class="project-links">
                                <a class="text-link" href="{{ notion_site }}Portfolio-Actuel-d8d871a5ca87461c9f4166354aa9b0ed" target="_blank" rel="noopener">
                                    {{ 'achievements_page.second_portfolio'|trans }}{{ ui.icon('arrow') }}<span class="visually-hidden"> {{ 'a11y.new_tab'|trans }}</span>
                                </a>
                                <a class="text-link" href="{{ notion_site }}Premier-Portfolio-51db66b3381f4a8f86781f6b97416088" target="_blank" rel="noopener">
                                    {{ 'achievements_page.first_portfolio'|trans }}{{ ui.icon('arrow') }}<span class="visually-hidden"> {{ 'a11y.new_tab'|trans }}</span>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        {# ---------- Contact ---------- #}
        <section class="section section-dark" id="contact" aria-labelledby="contact-title">
            <div class="container">
                <h2 class="section-title" id="contact-title">{{ 'contact_page.title'|trans }}</h2>
                <p class="section-intro">{{ 'contact_page.intro'|trans }}</p>
                {{ render_esi(url('contact')) }}
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p>© {{ 'now'|date('Y') }} {{ 'footer.rights'|trans }}</p>
            <a class="back-to-top" href="#top" aria-label="{{ 'a11y.back_to_top'|trans }}">{{ ui.icon('up') }}</a>
        </div>
    </footer>
{% endblock %}
